<?xml version="1.0"?>
<robot name="four_dof_arm">

  <material name="dark_grey">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="blue_accent">
    <color rgba="0.15 0.45 0.85 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="red_tip">
    <color rgba="0.85 0.20 0.20 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- BASE LINK: 8 cm (0.08 m) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001367" ixy="0.0" ixz="0.0"
               iyy="0.001367" iyz="0.0" izz="0.001667"/>
    </inertial>
  </link>

  <!-- JOINT 1: Base yaw (Z-axis) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="L1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- LINK 1 (L1): 12 cm (0.12 m) -->
  <link name="L1">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.12"/>
      </geometry>
      <material name="blue_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000320" ixy="0.0" ixz="0.0"
               iyy="0.000320" iyz="0.0" izz="0.000041"/>
    </inertial>
  </link>

  <!-- JOINT 2: Shoulder pitch (Y-axis) -->
  <joint name="joint2" type="revolute">
    <parent link="L1"/>
    <child link="L2"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- LINK 2 (L2): 15 cm (0.15 m) -->
  <link name="L2">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.032 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="0.032 0.032 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.000392" ixy="0.0" ixz="0.0"
               iyy="0.000392" iyz="0.0" izz="0.000034"/>
    </inertial>
  </link>

  <!-- JOINT 3: Elbow pitch (Y-axis) -->
  <joint name="joint3" type="revolute">
    <parent link="L2"/>
    <child link="L3"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- LINK 3 (L3): 9 cm (0.09 m) -->
  <link name="L3">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.026 0.09"/>
      </geometry>
      <material name="blue_accent"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.026 0.026 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000110" ixy="0.0" ixz="0.0"
               iyy="0.000110" iyz="0.0" izz="0.000017"/>
    </inertial>
  </link>

  <!-- JOINT 4: Wrist pitch (Y-axis) -->
  <joint name="joint4" type="revolute">
    <parent link="L3"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="2.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- END EFFECTOR: 6 cm (0.06 m) -->
  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
      <material name="red_tip"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.000025" ixy="0.0" ixz="0.0"
               iyy="0.000025" iyz="0.0" izz="0.000003"/>
    </inertial>
  </link>

  <!-- Gazebo Sim Trajectory Controller & Joint State Publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-trajectory-controller-system" name="gz::sim::systems::JointTrajectoryController">
      <topic>/arm_controller/joint_trajectory</topic>
      <joint_name>joint1</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>20.0</position_p_gain>
      <position_d_gain>1.0</position_d_gain>
      <joint_name>joint2</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>20.0</position_p_gain>
      <position_d_gain>1.0</position_d_gain>
      <joint_name>joint3</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>15.0</position_p_gain>
      <position_d_gain>0.8</position_d_gain>
      <joint_name>joint4</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>10.0</position_p_gain>
      <position_d_gain>0.5</position_d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>joint1</joint_name>
      <joint_name>joint2</joint_name>
      <joint_name>joint3</joint_name>
      <joint_name>joint4</joint_name>
    </plugin>
  </gazebo>

</robot>
